# DreamFly settings. Copy to .env and edit. Never commit .env.
# The defaults are the safe ones: testnet, dry run. In a dry run nothing is sent: the order mirror writes
# "would place" and "would cancel" lines to state/<market>/orders.jsonl.

# ── Network ─────────────────────────────────────────────────────────────────
# One network per bot. "testnet" (Shannon, chain 50312) or "mainnet" (chain 5031) run spot markets and event
# contracts. "hideki" (chain 50383) runs perps, the only network that has them: set PERP_MARKETS and leave
# MARKETS blank. Perps on testnet or mainnet, or spot on hideki, are refused at start. Start on testnet.
NETWORK=testnet

# ── Dry run or live ─────────────────────────────────────────────────────────
# true: log what would be placed, send nothing. false: place real spot orders.
DRY_RUN=true

# Needed only when DRY_RUN=false. The private key the fly trades with. Prefer a fresh wallet with a small
# balance. For mainnet, DRY_RUN=false also needs MAINNET_CONFIRM=yes.
# PRIVATE_KEY=0x...
# MAINNET_CONFIRM=yes

# ── What the fly runs ───────────────────────────────────────────────────────
# Spot markets, comma separated. One fly per market, and the dashboard shows only these.
# testnet: SOMI:USDso, WETH:USDso, WBTC:USDso. mainnet adds USDC.e:USDso.
MARKETS=WETH:USDso
# Perpetuals and event contracts need the Node sidecars (Node 20+). Both trade for real when DRY_RUN=false:
# perps on NETWORK=hideki, event contracts on NETWORK=mainnet (on the testnet they stay paper).
# PERP_MARKETS=all                        # or a list: BTC/USDso:USDso,ETH/USDso:USDso
# EC_ENABLED=false
# Perps: your DreamDEX account when PRIVATE_KEY is a bot key linked to it in the app (Link a bot, Perps).
# Blank: the key trades its own perps account (fund it with scripts/perp_smoke.py --deposit).
# OWNER_ADDRESS=
# Perps: live notional per market = LIVE_STAKE_USDSO x this (1 to 10).
# PERP_LEVERAGE=2

# ── Live order limits (spot) ────────────────────────────────────────────────
# Orders are scaled so one market never has more than about this much at work, in USDso.
LIVE_STAKE_USDSO=20
# Most resting orders per market.
MAX_OPEN_ORDERS=6
# A taker order is priced this many bps through the touch so it still fills after the order lands.
TAKE_BUFFER_BPS=10
# A resting order within this many bps of the wanted price is left alone, to avoid churn.
REQUOTE_BPS=5
# Least seconds between two order syncs on one market.
MIN_ORDER_GAP_S=2
# How long a resting order lives on the book.
QUOTE_TTL_MIN=90

# ── Optional overrides ──────────────────────────────────────────────────────
# RPC_URL=
# REST_API_URL=
# WS_URL=
# PORT=8765

# ── Faster learning (paper episodes) ────────────────────────────────────────
# Paper episodes running at once per spot market, all training the same brain, on different strategies.
# With live orders only the first one places orders; the rest are paper training.
CONCURRENT_EPISODES=3

# Learning brain for spot: delta (default) or mb.
# BRAIN=delta
# STATE_DIR=state/live
# DASHBOARD_PASSWORD=
