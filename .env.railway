# Default Railway variables (no secrets). Import: Railway service > Variables > RAW Editor > paste this file.
# The fly runs in dry run on testnet with the dashboard, until you change it.

# One network per service: testnet (Shannon), hideki or mainnet. Perps run on the two test networks only.
NETWORK=testnet
DRY_RUN=true

# Spot markets to run, comma separated, or none. The dashboard shows only these.
MARKETS=WETH:USDso
# BTC and ETH Up/Down windows on this network; with MARKETS=none they run on their own.
# EC_ENABLED=false
# Perps on a test network (hideki or testnet); on hideki MARKETS blank means no spot:
# PERP_MARKETS=all

LIVE_STAKE_USDSO=20
MAX_OPEN_ORDERS=6
TAKE_BUFFER_BPS=10
REQUOTE_BPS=5
MIN_ORDER_GAP_S=2
QUOTE_TTL_MIN=90

# To trade for real, set these as Railway variables (never commit them):
#   DRY_RUN=false
#   PRIVATE_KEY=0x...
#   MAINNET_CONFIRM=yes   (only if NETWORK=mainnet)

# Paper episodes at once per spot market, all training one brain.
CONCURRENT_EPISODES=3

# Learning brain for spot: delta (default) or mb.
# BRAIN=delta
# Perps with DRY_RUN=false: the account a linked bot key trades for (blank: the key's own perps account),
# and the leverage the live notional is sized with.
# OWNER_ADDRESS=
# PERP_LEVERAGE=2
# Keep the learned state across deploys: add a volume at /data and set this.
# STATE_DIR=/data/state
# Ask for a password before the dashboard shows anything (any user name).
# DASHBOARD_PASSWORD=
